{
  "name": "private-bin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "cf-types": "wrangler types",
    "configure:build": "node scripts/configure-build.mjs",
    "check": "pnpm cf-types && pnpm typecheck && pnpm test",
    "build:ci": "pnpm configure:build && pnpm check && pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
